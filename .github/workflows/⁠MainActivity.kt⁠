package com.example.mynewproject

import android.os.Bundle
import android.widget.Button
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // RealWear पर जब यूज़र बोलता है "CLICK ME", तो यह बटन ट्रिगर होगा
        val myButton = findViewById<Button>(R.id.btn_action)
        val myTextView = findViewById<TextView>(R.id.tv_status)

        myButton.setOnClickListener {
            myTextView.text = "Voice Command Received!"
            Toast.makeText(this, "RealWear Action Triggered!", Toast.LENGTH_SHORT).show()
        }
    }
}
